# Modelo do .env. Não preencha aqui: rode ./scripts/generate-env.sh para gerar o .env com segredos aleatórios.
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_AUTOMATION_CLIENT_SECRET=
KC_CADASTRO_CLIENT_SECRET=
KC_GRAFANA_CLIENT_SECRET=
KC_CADASTRO_IMPORTER_CLIENT_SECRET=
# Chave HMAC (Base64, 256 bits) que o Legado emitiu para o Keycloak: copie LEGADO_INTERNAL_KEYCLOAK_KEY do .env do
# legado (scripts/internal-credentials.sh). Não é gerada aqui: o Legado é o emissor (ADR-0005 do legado).
KC_LEGADO_SIGNING_KEY=
# A mesma chave serve ao formulário de login, ao reset de senha (legacy-reset-choose-user) e ao listener de
# conclusão (legacy-migration-completion): o docker-compose.yml a repassa às três configurações de provider.
