{
  "realm": "workspace",
  "enabled": true,
  "displayName": "Workspace",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "loginTheme": "workspace",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",

  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "eventsEnabled": false,
  "eventsListeners": ["workspace-audit", "legacy-migration-completion"],
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR", "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR", "REGISTER", "REGISTER_ERROR", "CLIENT_LOGIN_ERROR"
  ],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@workspace.local",
    "fromDisplayName": "Workspace",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrador: listagem de usuários; OTP obrigatório." },
      { "name": "user", "description": "Usuário: acesso ao próprio perfil." },
      {
        "name": "log-investigator",
        "description": "Investigação em logs: gera consultas por token; OTP obrigatório."
      },
      {
        "name": "user-importer",
        "description": "Importação em lote de usuários no Cadastro; exige acr=otp recente. Só por atribuição nominal."
      },
      {
        "name": "grafana-viewer",
        "description": "Grafana: acesso somente leitura (Viewer). Só por atribuição nominal."
      },
      {
        "name": "grafana-editor",
        "description": "Grafana: edição de dashboards (Editor). Só por atribuição nominal."
      },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-workspace",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "user"],
          "client": { "account": ["view-profile", "manage-account"] }
        }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-workspace", "composite": true, "clientRole": false },

  "clients": [
    {
      "clientId": "cadastro",
      "name": "Cadastro",
      "description": "BFF do Cadastro: login OIDC (Authorization Code + PKCE) e conta de serviço para a Admin API.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:4300/bff/signin-oidc"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "acr", "roles"],
      "protocolMappers": [
        {
          "name": "login",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "account-origin",
          "protocol": "openid-connect",
          "protocolMapper": "workspace-account-origin-mapper",
          "config": {
            "claim.name": "account_origin",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": ["kc-admin-api"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/"
      }
    },
    {
      "clientId": "cadastro-importer",
      "name": "Cadastro importer",
      "description": "Importação em lote do Cadastro: só conta de serviço (client credentials) para criar usuários sem senha.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["kc-admin-api"]
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "description": "Grafana OSS: login OIDC (Authorization Code + PKCE). Roles grafana-viewer, grafana-editor e admin no claim roles.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:3000/login/generic_oauth"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "acr", "roles", "profile", "email"],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login"
      }
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "scopeMappings": [
    { "client": "cadastro", "roles": ["admin", "user", "log-investigator", "user-importer"] },
    { "client": "grafana", "roles": ["admin", "grafana-viewer", "grafana-editor"] }
  ],
  "clientScopeMappings": {
    "realm-management": [
      { "client": "cadastro", "roles": ["view-users", "query-users", "manage-users"] },
      { "client": "cadastro-importer", "roles": ["view-users", "manage-users"] }
    ]
  },
  "users": [
    {
      "username": "service-account-cadastro",
      "enabled": true,
      "serviceAccountClientId": "cadastro",
      "clientRoles": { "realm-management": ["view-users", "query-users", "manage-users"] }
    },
    {
      "username": "service-account-cadastro-importer",
      "enabled": true,
      "serviceAccountClientId": "cadastro-importer",
      "clientRoles": { "realm-management": ["view-users", "manage-users"] }
    }
  ],

  "requiredActions": [
    { "alias": "TERMS_AND_CONDITIONS", "name": "Terms and Conditions", "providerId": "TERMS_AND_CONDITIONS", "enabled": false, "defaultAction": false, "priority": 20 },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": true, "defaultAction": false, "priority": 40 },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50 },
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 54 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 57 },
    { "alias": "delete_account", "name": "Delete Account", "providerId": "delete_account", "enabled": false, "defaultAction": false, "priority": 60 },
    { "alias": "UPDATE_EMAIL", "name": "Update Email", "providerId": "UPDATE_EMAIL", "enabled": false, "defaultAction": false, "priority": 70 },
    { "alias": "webauthn-register", "name": "Webauthn Register", "providerId": "webauthn-register", "enabled": true, "defaultAction": false, "priority": 80 },
    { "alias": "webauthn-register-passwordless", "name": "Webauthn Register Passwordless", "providerId": "webauthn-register-passwordless", "enabled": true, "defaultAction": false, "priority": 90 },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": true, "defaultAction": false, "priority": 100 },
    { "alias": "delete_credential", "name": "Delete Credential", "providerId": "delete_credential", "enabled": true, "defaultAction": false, "priority": 110 },
    { "alias": "idp_link", "name": "Linking Identity Provider", "providerId": "idp_link", "enabled": false, "defaultAction": false, "priority": 120 },
    { "alias": "CONFIGURE_RECOVERY_AUTHN_CODES", "name": "Recovery Authentication Codes", "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES", "enabled": true, "defaultAction": false, "priority": 130 },
    { "alias": "update_user_locale", "name": "Update User Locale", "providerId": "update_user_locale", "enabled": true, "defaultAction": false, "priority": 1000 }
  ],
  "attributes": { "acr.loa.map": "{\"password\":1,\"otp\":2}" },
  "browserFlow": "workspace-browser",
  "resetCredentialsFlow": "workspace-reset-credentials",
  "authenticationFlows": [
    {
      "alias": "workspace-browser",
      "description": "Login do navegador: usuário e senha com migração do Legado, step-up por LoA e OTP obrigatório para log-investigator e admin.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 20, "flowAlias": "workspace-browser-v2-forms", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-forms",
      "description": "Formulários de login por nível de autenticação.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 10, "flowAlias": "workspace-browser-v2-password", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "flowAlias": "workspace-browser-v2-step-up-otp", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 30, "flowAlias": "workspace-browser-v2-otp-by-role", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 40, "flowAlias": "workspace-browser-v2-otp-by-admin", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 50, "flowAlias": "workspace-browser-v2-otp-configured", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-password",
      "description": "LoA 1: usuário e senha.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "workspace-browser-v2-loa-password", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "legacy-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-step-up-otp",
      "description": "LoA 2 (acr otp): OTP nesta autenticação.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "workspace-browser-v2-loa-otp", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-otp-by-role",
      "description": "OTP obrigatório para log-investigator.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-browser-v2-role-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-browser-v2-otp-not-used-by-role", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-otp-by-admin",
      "description": "OTP obrigatório para admin (RN-12).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-browser-v2-role-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-browser-v2-otp-not-used-by-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-browser-v2-otp-configured",
      "description": "OTP para quem já o configurou (como no browser padrão).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-browser-v2-otp-not-used-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-reset-credentials",
      "description": "Reset de senha por e-mail; OTP obrigatório para log-investigator e admin.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "legacy-reset-choose-user", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "reset-credential-email", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "reset-password", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 40, "flowAlias": "workspace-reset-v3-otp-by-role", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 50, "flowAlias": "workspace-reset-v3-otp-by-admin", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 60, "flowAlias": "workspace-reset-v3-otp-configured", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-reset-v3-otp-by-role",
      "description": "OTP obrigatório para log-investigator.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-reset-v3-role-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-reset-v3-otp-by-admin",
      "description": "OTP obrigatório para admin que não é log-investigator (este já confirma o OTP acima).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-reset-v3-role-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-reset-v3-admin-not-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-reset-v3-otp-configured",
      "description": "Reset padrão do OTP configurado, exceto log-investigator e admin.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-reset-v3-not-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-reset-v3-not-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false },
        { "authenticator": "reset-otp", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 40, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-first-broker-login",
      "description": "Primeiro login com provedor externo: só conta existente, vinculada após a senha dela.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "idp-detect-existing-broker-user", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "idp-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-post-broker-login",
      "description": "Pós-login com provedor externo: OTP para roles privilegiadas e para quem já o configurou.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 10, "flowAlias": "workspace-broker-v1-otp-by-admin", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "flowAlias": "workspace-broker-v1-otp-by-log-investigator", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 30, "flowAlias": "workspace-broker-v1-otp-by-user-importer", "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 40, "flowAlias": "workspace-broker-v1-otp-configured", "userSetupAllowed": false },
        { "authenticator": "allow-access-authenticator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 50, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-broker-v1-otp-by-admin",
      "description": "OTP obrigatório para admin.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-broker-v1-role-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-broker-v1-otp-not-used-by-admin", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-broker-v1-otp-by-log-investigator",
      "description": "OTP obrigatório para log-investigator.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-broker-v1-role-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-broker-v1-otp-not-used-by-log-investigator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-broker-v1-otp-by-user-importer",
      "description": "OTP obrigatório para user-importer.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "workspace-broker-v1-role-user-importer", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-broker-v1-otp-not-used-by-user-importer", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "workspace-broker-v1-otp-configured",
      "description": "OTP para quem já o configurou.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-credential", "authenticatorConfig": "workspace-broker-v1-otp-not-used-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
