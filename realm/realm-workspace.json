{
  "realm": "workspace",
  "enabled": true,
  "displayName": "Workspace",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "loginTheme": "workspace",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",

  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "eventsEnabled": false,
  "eventsListeners": ["workspace-audit"],
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR", "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR", "REGISTER", "REGISTER_ERROR", "CLIENT_LOGIN_ERROR"
  ],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@workspace.local",
    "fromDisplayName": "Workspace",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrador: listagem de usuários; OTP obrigatório." },
      { "name": "user", "description": "Usuário: acesso ao próprio perfil." },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-workspace",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "user"],
          "client": { "account": ["view-profile", "manage-account"] }
        }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-workspace", "composite": true, "clientRole": false },

  "clients": [
    {
      "clientId": "cadastro",
      "name": "Cadastro",
      "description": "BFF do Cadastro: login OIDC (Authorization Code + PKCE) e conta de serviço para a Admin API.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:4300/bff/signin-oidc"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "acr", "roles"],
      "protocolMappers": [
        {
          "name": "login",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": ["kc-admin-api"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/"
      }
    },
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "scopeMappings": [
    { "client": "cadastro", "roles": ["admin", "user"] }
  ],
  "clientScopeMappings": {
    "realm-management": [
      { "client": "cadastro", "roles": ["view-users", "query-users", "manage-users"] }
    ]
  },
  "users": [
    {
      "username": "service-account-cadastro",
      "enabled": true,
      "serviceAccountClientId": "cadastro",
      "clientRoles": { "realm-management": ["view-users", "query-users", "manage-users"] }
    }
  ],

  "clientProfiles": {
    "profiles": [
      {
        "name": "workspace-pkce-s256",
        "description": "Exige PKCE com S256 no Authorization Code (security.md).",
        "executors": [
          { "executor": "pkce-enforcer", "configuration": { "auto-configure": "true" } }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "workspace-pkce-all-clients",
        "description": "Aplica PKCE S256 a todos os clients do realm.",
        "enabled": true,
        "conditions": [
          { "condition": "any-client", "configuration": {} }
        ],
        "profiles": ["workspace-pkce-s256"]
      }
    ]
  }
}
