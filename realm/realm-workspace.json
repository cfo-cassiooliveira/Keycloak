{
  "realm": "workspace",
  "enabled": true,
  "displayName": "Workspace",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "loginTheme": "workspace",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",

  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "eventsEnabled": false,
  "eventsListeners": ["workspace-audit"],
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR", "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR", "REGISTER", "REGISTER_ERROR", "CLIENT_LOGIN_ERROR"
  ],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,

  "clients": [
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "clientProfiles": {
    "profiles": [
      {
        "name": "workspace-pkce-s256",
        "description": "Exige PKCE com S256 no Authorization Code (security.md).",
        "executors": [
          { "executor": "pkce-enforcer", "configuration": { "auto-configure": "true" } }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "workspace-pkce-all-clients",
        "description": "Aplica PKCE S256 a todos os clients do realm.",
        "enabled": true,
        "conditions": [
          { "condition": "any-client", "configuration": {} }
        ],
        "profiles": ["workspace-pkce-s256"]
      }
    ]
  }
}
